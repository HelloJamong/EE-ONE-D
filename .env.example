# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-client-id
# COMMAND_SCOPE: global | guild
COMMAND_SCOPE=guild
DISCORD_GUILD_ID=your-guild-id

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/eeoned?schema=public

# Runtime
NODE_ENV=production
LOG_LEVEL=info

# Instagram 임베드 (선택, 기본값 있음 — IG가 GraphQL 스키마를 바꿔 임베드가 전부 실패하면 갱신)
# IG_DOC_ID=10015901848480474
# IG_APP_ID=936619743392459
